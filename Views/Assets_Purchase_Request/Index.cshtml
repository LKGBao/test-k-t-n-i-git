@model IEnumerable<Nets_System.Models.Assets_Purchase_Request>

@{
    ViewData["Title"] = "Yêu cầu mua sắm";
    var branchId = ViewBag.BranchId as int?;
    var branchName = ViewBag.BranchName as string ?? "Chi nhánh";
}

<h1>Yêu cầu mua sắm tài sản</h1>
<p class="text-muted">
    Chi nhánh: <strong>@branchName</strong>
    @if (branchId.HasValue)
    {
        <span class="ms-2">
            <a asp-controller="Branches" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Danh sách chi nhánh</a>
        </span>
    }
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Reason)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>@Html.DisplayNameFor(model => model.Note)</th>
            <th>@Html.DisplayNameFor(model => model.Created_Time)</th>
            <th>@Html.DisplayNameFor(model => model.Last_Modified_Time)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Reason)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>@Html.DisplayFor(modelItem => item.Note)</td>
                <td>@Html.DisplayFor(modelItem => item.Created_Time)</td>
                <td>@Html.DisplayFor(modelItem => item.Last_Modified_Time)</td>
                <td>
                    @if (string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                    {
                        <a asp-action="Approve" asp-route-id="@item.Id" asp-route-branchId="@branchId" class="btn btn-sm btn-primary">Phê duyệt</a>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Chi nhánh này chưa có yêu cầu mua sắm nào.</p>
}
