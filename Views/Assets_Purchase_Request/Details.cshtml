@model Nets_System.Models.Assets_Purchase_Request

@{
    ViewData["Title"] = ViewBag.ShowApproveButtons == true ? "Phê duyệt yêu cầu" : "Chi tiết yêu cầu";
    var showApproveButtons = ViewBag.ShowApproveButtons == true;
    var branchId = ViewBag.BranchId as int?;
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Yêu cầu mua sắm #@Model.Id</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Reason)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Reason)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Note)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Note)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Created_Time)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Created_Time)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Last_Modified_Time)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Last_Modified_Time)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BranchManager)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BranchManager.Id)
        </dd>
    </dl>
</div>

<h5 class="mt-4">Danh sách tài sản cần mua</h5>
<table class="table table-bordered mt-2">
    <thead>
        <tr>
            <th>Danh mục tài sản</th>
            <th>Số lượng</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items != null && Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@(item.Asset_Category?.Name ?? item.Asset_Category_Id.ToString())</td>
                    <td>@item.Quantity</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-muted">Chưa có danh mục tài sản nào trong yêu cầu này.</td>
            </tr>
        }
    </tbody>
</table>

@if (showApproveButtons)
{
    <div class="mt-4 d-flex gap-2">
        <form asp-action="Accept" asp-route-id="@Model.Id" asp-route-branchId="@branchId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Chấp nhận</button>
        </form>
        <form asp-action="Reject" asp-route-id="@Model.Id" asp-route-branchId="@branchId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger" onclick="return confirm('Bạn có chắc muốn từ chối yêu cầu này?');">Từ chối</button>
        </form>
    </div>
}

<div class="mt-3">
    @if (branchId.HasValue)
    {
        <a asp-action="Index" asp-route-branchId="@branchId">← Danh sách yêu cầu</a>
    }
    else
    {
        <a asp-controller="Branches" asp-action="Index">← Danh sách chi nhánh</a>
    }
</div>
