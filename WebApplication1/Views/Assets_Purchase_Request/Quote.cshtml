@model WebApplication1.Models.Assets_Purchase_Request

@{
    ViewData["Title"] = "Báo giá yêu cầu mua sắm";
    var branchId = ViewBag.BranchId as int?;
    var branchName = ViewBag.BranchName as string ?? "Chi nhánh";
    var suppliers = ViewBag.Suppliers as SelectList;
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted">
    Chi nhánh: <strong>@branchName</strong> |
    Yêu cầu #@Model.Id
</p>

<div class="mb-3">
    <h5>Thông tin yêu cầu</h5>
    <dl class="row">
        <dt class="col-sm-2">Lý do</dt>
        <dd class="col-sm-10">@Model.Reason</dd>

        <dt class="col-sm-2">Trạng thái</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">Ghi chú</dt>
        <dd class="col-sm-10">@Model.Note</dd>
    </dl>
</div>

<h5>Báo giá theo từng tài sản</h5>

<form asp-action="Quote" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="RequestId" value="@Model.Id" />
    <input type="hidden" name="BranchId" value="@branchId" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Nhà cung cấp</label>
        <input type="text"
               name="SupplierName"
               class="form-control"
               list="supplierList"
               placeholder="Nhập tên nhà cung cấp..." />

        <datalist id="supplierList">
            @if (suppliers != null)
            {
                foreach (var supplier in suppliers)
                {
                    <option value="@supplier.Text"></option>
                }
            }
        </datalist>
    </div>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Danh mục tài sản</th>
                <th>Đơn giá dự kiến</th>
                <th>Chiết khấu (%)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                var index = 0;
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @(item.Asset_Category?.Name ?? item.Asset_Category_Id.ToString())
                        </td>
                        <td>
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   name="QuotationItems[@index].UnitPrice"
                                   placeholder="Nhập đơn giá" />
                        </td>
                        <td>
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   max="100"
                                   class="form-control"
                                   name="QuotationItems[@index].DiscountPercent"
                                   placeholder="Chiết khấu (%)" />
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-muted">
                        Yêu cầu này chưa có loại tài sản nào.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Lưu báo giá</button>
        <a asp-action="Index" asp-route-branchId="@branchId" class="btn btn-secondary ms-2">← Quay lại danh sách yêu cầu</a>
    </div>
</form>

@section Scripts {
}

