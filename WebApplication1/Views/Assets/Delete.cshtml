@model WebApplication1.Models.Asset

@{
    ViewData["Title"] = "Xóa tài sản";
}

<h1>Xóa tài sản</h1>

<h3>Bạn có chắc chắn muốn xóa tài sản này?</h3>
<div>
    <h4>Asset</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Branch_Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Branch_Id)
        </dd>
        <dt class = "col-sm-2">
            Danh mục
        </dt>
        <dd class = "col-sm-10">
            @(Model.Category?.Name ?? Model.Category_Id?.ToString())
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Barcode)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Barcode)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Created_Time)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Created_Time)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Last_Modified_Time)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Last_Modified_Time)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
