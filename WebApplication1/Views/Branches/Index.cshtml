@model IEnumerable<WebApplication1.Models.Branch>

@{
    ViewData["Title"] = "Chi nhánh";
}

<h1>Danh sách chi nhánh</h1>
<p class="text-muted">Chọn chi nhánh để xem yêu cầu mua sắm tài sản.</p>

<table class="table">
    <thead>
        <tr>
            <th>Tên chi nhánh</th>
            <th>Địa chỉ</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>
                    <a asp-controller="Assets_Purchase_Request" asp-action="Index" asp-route-branchId="@item.Id" class="btn btn-primary btn-sm">
                        Yêu cầu mua sắm
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Chưa có chi nhánh nào.</p>
}
